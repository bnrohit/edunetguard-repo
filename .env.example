# EduNetGuard Environment Configuration
# Copy this file to .env and customize.

NODE_ENV=production
PORT=4000

# Host bindings
WEB_PORT=3000
API_PORT=4000
KUMA_BIND_IP=127.0.0.1
KUMA_ADMIN_PORT=3001

# Internal monitoring integration
UPTIME_KUMA_URL=http://uptime-kuma:3001
UPTIME_KUMA_STATUS_PAGE=edunetguard
CACHE_TTL=30

# Invite-based EduNetGuard accounts.
# Generate AUTH_SECRET with: openssl rand -hex 32
AUTH_SECRET=
USER_JOIN_CODE=
ADMIN_JOIN_CODE=
SESSION_TTL_SECONDS=43200
COOKIE_SECURE=false

# User-owned monitoring policy
USER_MONITOR_MAX_PER_USER=20
USER_MONITOR_MIN_INTERVAL_SECONDS=30
USER_MONITOR_MAX_INTERVAL_SECONDS=86400
USER_MONITOR_DEFAULT_TIMEOUT_SECONDS=10
USER_MONITOR_MAX_TIMEOUT_SECONDS=30
USER_MONITOR_HISTORY_LIMIT=120
USER_MONITOR_ALLOW_PUBLIC_TARGETS=true
# Private/internal targets are blocked unless explicitly approved here.
# Example: USER_MONITOR_ALLOWED_CIDRS=10.128.0.0/16,10.250.0.0/16
USER_MONITOR_ALLOWED_CIDRS=

# Production default: never present sample data as operational telemetry.
ALLOW_DEMO_FALLBACK=false

# Frontend
REACT_APP_API_URL=/api
REACT_APP_REFRESH_INTERVAL=30000

ALLOWED_ORIGINS=http://localhost:3000,http://localhost
TZ=America/Denver
